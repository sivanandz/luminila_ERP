# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
*.tsbuildinfo
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# storefront build output and optional local build snapshots
storefront/out/
storefront/catalog-snapshot.json
storefront/content-snapshot.json

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Universal ignores
**/node_modules
**/dist
**/build
**/out
**/.next
**/.vercel
**/.idea
**/.vscode
**/*.log
**.DS_Store
**.env
**.env.local
**.env.development.local
**.env.test.local
**.env.production.local

# PocketBase data files (runtime data is untouched, zero demo data shipped)
pocketbase/pb_data/*
!pocketbase/pb_data/.gitkeep
pocketbase/pb_tenants/

# Desktop build output (server-dist holds generated Next standalone output;
# only the placeholder README is tracked)
server-dist/*
!server-dist/README.md

# Runtime JSON data
src/data/*.json
!src/data/.gitkeep

# Backup directories
backup_*/

# Specific ignores
wppconnect-sidecar/tokens/
wppconnect-sidecar/tokens/**
wppconnect-sidecar/userData/
wppconnect-sidecar/*.png
wppconnect-sidecar/debug_qr.png
.luminila/
src-tauri/binaries/
src-tauri/gen/android/local.properties

# Agent & workspace artifacts
.mimosa/
.v2c/
.video_agent/
.zcodeignore
.zcode/
.cursor/
scratch/
**/.kotlin/
