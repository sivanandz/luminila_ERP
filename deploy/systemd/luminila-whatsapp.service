[Unit]
Description=Luminila WPPConnect sidecar (private, tailnet only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=luminila
Group=luminila
WorkingDirectory=/opt/luminila/app
EnvironmentFile=/etc/luminila/env
Environment=WPPCONNECT_PORT=21465
ExecStart=/usr/bin/node /opt/luminila/app/wppconnect-sidecar/server.js
Restart=always
RestartSec=5
TimeoutStopSec=20

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/luminila/app/wppconnect-sidecar

[Install]
WantedBy=multi-user.target
