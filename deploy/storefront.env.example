# Niththigal Storefront VPS environment — copy to /etc/luminila/storefront.env, chmod 600.
# Loaded by luminila-storefront.service and the storefront build step.

# ── runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
HOSTNAME=127.0.0.1
BUILD_STANDALONE=true

# ── public storefront & ERP API origins ──────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://niththigal.com
# Dedicated host for ERP-owned public surfaces (/api/storefront/*, /tracking,
# /checkout/whatsapp) so ERP's /_next/static chunks never collide with :3001.
# JSON API calls (/api/storefront/*, /api/tracking/*, /api/webhooks/razorpay)
# also work on https://niththigal.com directly via Cloudflare Tunnel path routing.
NEXT_PUBLIC_ERP_API_URL=https://api.niththigal.com
# Build-time origin used during `npm run build` in /opt/luminila/app/storefront.
# Point to https://api.niththigal.com once live, or http://127.0.0.1:3000 with
# STOREFRONT_ALLOW_LOCAL_ERP=true for initial VPS bootstrap before DNS cutover.
ERP_API_URL=https://api.niththigal.com
# STOREFRONT_ALLOW_LOCAL_ERP=true

# Direct PocketBase fallback is disabled on public storefronts (audit L-04); keep
# same-origin /api/pb default rather than exposing the tailnet PB URL here.
# NEXT_PUBLIC_POCKETBASE_URL=

# ── brand & contact ──────────────────────────────────────────────────────────
NEXT_PUBLIC_STORE_NAME=Niththigal
NEXT_PUBLIC_WHATSAPP_PHONE=
NEXT_PUBLIC_STORE_CURRENCY=INR

# ── SEO / AI discoverability ─────────────────────────────────────────────────
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
INDEXNOW_KEY=
SEO_BLOCK_AI_TRAINING=false
STOREFRONT_CATALOG_SNAPSHOT=catalog-snapshot.json
STOREFRONT_CONTENT_SNAPSHOT=content-snapshot.json
