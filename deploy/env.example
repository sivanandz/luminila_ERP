# Luminila VPS environment — copy to /etc/luminila/env, chmod 600, fill values.
# Loaded by systemd (EnvironmentFile) and by the build step.

# ── runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOSTNAME=127.0.0.1

# Server-side PocketBase origin (loopback; never public)
PB_URL=http://127.0.0.1:8090

# ── build-time public values (inlined into the browser bundle) ───────────────
# ERP/browser PocketBase URL: tailnet HTTPS port served by `tailscale serve`.
NEXT_PUBLIC_POCKETBASE_URL=https://REPLACE-MACHINE.REPLACE-TAILNET.ts.net:10000
# WhatsApp sidecar tailnet URL (browser → sidecar).
NEXT_PUBLIC_WPPCONNECT_URL=https://REPLACE-MACHINE.REPLACE-TAILNET.ts.net:8443
# Public storefront origin, used by CMS image previews and "View storefront".
NEXT_PUBLIC_STOREFRONT_URL=https://shop.REPLACE-DOMAIN
# Canonical public origin used by the storefront's metadata, canonicals,
# JSON-LD, sitemap, llms.txt, and Merchant feed. Keep it identical to
# NEXT_PUBLIC_STOREFRONT_URL unless the two intentionally differ.
NEXT_PUBLIC_SITE_URL=https://shop.REPLACE-DOMAIN
# Absolute ERP origin read at BUILD TIME by the storefront's static export.
# In the unified-domain deployment this is the public storefront origin,
# because /api/storefront/* is proxied to the ERP.
ERP_API_URL=https://shop.REPLACE-DOMAIN
# Local development only: allow a loopback/private ERP origin at build time.
# Leave unset in production.
# STOREFRONT_ALLOW_LOCAL_ERP=true

# ── storefront SEO / AI discoverability ──────────────────────────────────────
# Search engine ownership verification (optional).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
# IndexNow key: 8-128 chars, a-z A-Z 0-9 and -. `npm run seo:indexnow`
# writes public/<key>.txt and submits sitemap URLs to the shared endpoint.
INDEXNOW_KEY=
# true disallows GPTBot, ClaudeBot, CCBot and (when verified) Google-Extended.
# Search/answer crawlers remain allowed.
SEO_BLOCK_AI_TRAINING=false
# Optional offline/CI catalog snapshot for build-time product pages and feed.
STOREFRONT_CATALOG_SNAPSHOT=catalog-snapshot.json
# Optional offline/CI CMS snapshot for build-time content.
STOREFRONT_CONTENT_SNAPSHOT=content-snapshot.json

# ── private/public host split (enforced by src/proxy.ts) ─────────────────────
# ERP hostname(s): tailnet name and any localhost entries.
ADMIN_HOSTS=REPLACE-MACHINE.REPLACE-TAILNET.ts.net,localhost,127.0.0.1
# Public storefront hostname(s) served through Cloudflare Tunnel.
STOREFRONT_HOSTS=shop.REPLACE-DOMAIN

# ── secrets (generate fresh per deployment) ──────────────────────────────────
CUSTOMER_SESSION_SECRET=
JWT_SECRET=
CATALOG_SYNC_KEY=
META_CATALOG_ID=
META_BUSINESS_PHONE=
META_GRAPH_ACCESS_TOKEN=
META_GRAPH_VERSION=v21.0
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
POCKETBASE_SUPERUSER_EMAIL=
POCKETBASE_SUPERUSER_PASSWORD=

# 64 hex characters. Keep an offline copy: losing it means encrypted tenant
# passwords must be reset, not recovered.
TENANT_REGISTRY_KEY=

# ── AI harness (in-app assistant) ────────────────────────────────────────────
# Optional dedicated key for provider API-key encryption (64 hex chars). When
# empty, TENANT_REGISTRY_KEY is used, which this deployment already requires.
AI_SECRET_KEY=
# Optional environment-only OpenAI-compatible provider (read-only in the UI):
# OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
# OPENAI_COMPAT_API_KEY=
# OPENAI_COMPAT_MODEL=gpt-4.1-mini
# OPENAI_COMPAT_NAME=OpenAI
# OPENAI_COMPAT_DISABLE_TOOLS=
# OPENAI_COMPAT_TEMPERATURE=0.3
# OPENAI_COMPAT_MAX_TOKENS=2048
# OPENAI_COMPAT_TIMEOUT_MS=120000

# ── WhatsApp sidecar ─────────────────────────────────────────────────────────
WPPCONNECT_PORT=21465
# >= 16 chars; the sidecar refuses to start with a shorter secret.
WPPCONNECT_SECRET=
# Browser origin of the ERP (the page that calls the sidecar).
WPP_ALLOWED_ORIGINS=https://REPLACE-MACHINE.REPLACE-TAILNET.ts.net

# ── optional ─────────────────────────────────────────────────────────────────
OTP_DAILY_LIMIT=5
# Set to "off" to disable the host guard (do not use on a public VPS).
# HOST_GUARD=off
